BIC_N   <- vector("list", length = length(nclus))
BIC_G   <- vector("list", length = length(nclus))
AIC_3   <- vector("list", length = length(nclus))
n_pars <- vector("list", length = length(nclus))
# Run for loop with all the required models
for(k in nclus){
fits[[k]] <- hmm_mmgsem(..., nstates = k)
# Compute BIC
logliks[[k]] <- fits[[k]]$loglik
n_pars[[k]]  <- fits[[k]]$n_par
BIC_N[[k]] <- (-2 * logliks[[k]]) + (n_pars[[k]] * log(sum(N_gs)))
BIC_G[[k]] <- (-2 * logliks[[k]]) + (n_pars[[k]] * log(sum(ngroups * k)))
AIC_3[[k]] <- (-2 * logliks[[k]]) + (n_pars[[k]] * 3)
}
# CHull computations
CHull_res <- CHull(loglik = unlist(logliks), nrpar = unlist(n_pars), nsclust = c(nclus[1], nclus[length(nclus)]))
browser()
# Final results matrix
overview <- cbind(CHull_res,
unlist(BIC_G),
unlist(BIC_N),
unlist(AIC_3))
colnames(overview) <- c("K", "loglik", "n_par", "CHull", "BIC_N", "BIC_G", "AIC_3")
overview <- as.data.frame(overview)
return(overview)
}
