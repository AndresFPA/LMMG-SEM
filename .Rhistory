screeratios[convexhull[nclust]-nsclust[1]+1]=((LL_nclust-LL_nclustmin1)/(npar_nclust-npar_nclustmin1))/((LL_nclustplus1-LL_nclust)/(npar_nclustplus1-npar_nclust))
} else {
screeratios[convexhull[nclust]-nsclust[1]+1]=NA
change=1
}
}
}
